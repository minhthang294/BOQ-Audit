APP_ENV=development
BACKEND_SECRET_KEY=change-this-in-production

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this
ADMIN_NAME=Administrator

DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=
DEMO_NAME=Demo Customer

DATABASE_URL=sqlite:////data/database/boq.db
DATA_DIR=/data
MAX_UPLOAD_MB=500
FRONTEND_URL=http://localhost
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MAX_TOTAL_STORAGE_MB=51200
MIN_FREE_DISK_MB=2048
UPLOAD_RATE_LIMIT=10
UPLOAD_RATE_WINDOW_SECONDS=3600
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
COOKIE_SECURE=false
SESSION_EXPIRE_HOURS=12

# Automatic Codex BOQ audit worker
CODEX_COMMAND=codex
CODEX_TIMEOUT_SECONDS=21600
CODEX_USAGE_CACHE_SECONDS=60
CODEX_USAGE_QUERY_TIMEOUT_SECONDS=15
# Install/mount the boq-audit skill at this path in the backend worker
BOQ_AUDIT_SKILL_PATH=/opt/codex/skills/boq-audit/SKILL.md
# Host directory mounted into the backend container
BOQ_AUDIT_SKILL_HOST_PATH=/home/thangpham/.agents/skills/boq-audit

# Private SBTech AI gateway; generate with: openssl rand -hex 32
CHAT_GATEWAY_TOKEN=
CHAT_GATEWAY_URL=http://chat:8010
CHAT_TIMEOUT_SECONDS=120
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=3600

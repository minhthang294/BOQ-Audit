{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boq-audit.local/schemas/q10/corpus_manifest.schema.json",
  "title": "Q10 offline corpus manifest v1",
  "description": "Metadata only; adjudication packages remain in access-controlled storage outside runtime mounts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "manifest_revision", "curator_id", "curated_at", "change_reason", "packages"],
  "properties": {
    "schema_version": {"const": "q10.corpus_manifest/1"},
    "corpus_id": {"$ref": "#/$defs/id"},
    "manifest_revision": {"type": "integer", "minimum": 1},
    "curator_id": {"$ref": "#/$defs/id"},
    "curated_at": {"type": "string", "format": "date-time"},
    "change_reason": {"type": "string", "minLength": 1},
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "audit_package_id", "reference_package_id", "partition", "source_family_ids", "reference_path", "reference_sha256", "adjudication_path", "adjudication_sha256", "run_record_path", "run_record_sha256"],
        "properties": {
          "case_id": {"$ref": "#/$defs/id"},
          "audit_package_id": {"$ref": "#/$defs/id"},
          "reference_package_id": {"$ref": "#/$defs/id"},
          "partition": {"enum": ["DEVELOPMENT", "HOLDOUT"]},
          "source_family_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "reference_path": {"type": "string", "minLength": 1},
          "reference_sha256": {"$ref": "#/$defs/sha256"},
          "adjudication_path": {"type": "string", "minLength": 1},
          "adjudication_sha256": {"$ref": "#/$defs/sha256"},
          "run_record_path": {"type": "string", "minLength": 1},
          "run_record_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

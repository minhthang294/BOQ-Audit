{
    auto_https off
}

:80 {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; frame-src 'self' blob:; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; worker-src 'self' blob:"
        -Server
    }

    # Firefox mở PDF bằng viewer nội bộ và từ chối iframe nếu response có
    # X-Frame-Options. Chỉ hai endpoint PDF inline được loại trừ; mọi route
    # còn lại vẫn không được phép nhúng trong trang khác.
    @notPdfViewer not path /api/jobs/*/input/view /api/jobs/*/outputs/*/view
    header @notPdfViewer X-Frame-Options DENY

    @excelUploads {
        method POST
        path /api/excel/upload
    }
    request_body @excelUploads {
        # Trình giải thích Excel chỉ nhận một tệp .xlsx/.xlsm tối đa 25MB.
        max_size 30MB
    }

    @uploads {
        method POST
        path /api/jobs /api/admin/jobs/*/outputs
    }
    request_body @uploads {
        # Một yêu cầu tạo hồ sơ có thể chứa PDF, Excel và thuyết minh, mỗi tệp tối đa
        # MAX_UPLOAD_MB; chừa thêm dung lượng cho multipart overhead.
        max_size 1520MB
    }

    @chatMessages {
        method POST
        path /api/jobs/*/chat/messages
    }
    request_body @chatMessages {
        max_size 16KB
    }

    @api path /api/*
    handle @api {
        reverse_proxy backend:8000 {
            transport http {
                dial_timeout 10s
                read_timeout 180s
                write_timeout 180s
            }
        }
    }

    # Trợ giúp vẽ (SBTech CAD Studio) đi sau phiên đăng nhập của portal: Caddy kiểm tra
    # /api/auth/me rồi mới chuyển tiếp vào container CAD, sau khi bỏ tiền tố /cad.
    # Chi tiết: docs/portal-cad.md.
    redir /cad /cad/ 308

    @cadUploads {
        method POST
        path /cad/*
    }
    request_body @cadUploads {
        # CAD nhận tối đa 4 tệp ≤ 10MB qua multipart; 64MB là mức dư an toàn.
        max_size 64MB
    }

    handle_path /cad/* {
        forward_auth backend:8000 {
            method GET
            uri /api/auth/me
            @unauthorized status 401
            handle_response @unauthorized {
                # Điều hướng trang → về màn hình đăng nhập; XHR nhận 401 để UI CAD báo lỗi.
                @html header Accept *text/html*
                redir @html /login 303
                respond 401
            }
        }
        reverse_proxy sbtech-cad:4173
    }

    handle {
        reverse_proxy frontend:3000
    }
}
